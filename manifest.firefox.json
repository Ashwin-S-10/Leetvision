{
  "manifest_version": 3,
  "name": "Leetvision",
  "version": "1.0.1",
  "description": "AI analysis of your LeetCode submissions, saved for spaced-repetition revision on your Leetvision dashboard.",
  "homepage_url": "https://www.leetvision.tech",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api-leetvision.onrender.com/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leetvision"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "config.js",
        "ui.js",
        "extractor.js",
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leetvision@leetvision.in",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  }
}
